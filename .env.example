# Browser calls go to Vite at /api, which proxies to FastAPI.
# Leave this as /api in local development.
VITE_API_BASE_URL=/api

# Used only during SSR (TanStack Start server) to reach FastAPI directly.
# Do not point this at /api — there is no Vite proxy on the Node server.
VITE_API_SERVER_URL=http://127.0.0.1:8000
